{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "기본 권한. 앱 명령은 main 창에만 준다 (로그인 창은 권한이 없다).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "dialog:default",
    "allow-get-settings",
    "allow-save-settings",
    "allow-begin-view",
    "allow-list-top",
    "allow-list-all",
    "allow-list-arca",
    "allow-search",
    "allow-open-package",
    "allow-parse-input",
    "allow-enqueue",
    "allow-pause-queue",
    "allow-cancel-queue",
    "allow-open-folder",
    "allow-cache-stats",
    "allow-clear-cache",
    "allow-check-update",
    "allow-download-update",
    "allow-cancel-update",
    "allow-apply-update",
    "allow-skip-version",
    "allow-open-release-page",
    "allow-take-last-error",
    "allow-arca-status",
    "allow-arca-login",
    "allow-arca-login-cancel",
    "allow-arca-logout",
    "allow-arca-forget-session"
  ]
}
